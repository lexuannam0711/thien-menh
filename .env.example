# ==============================================================================
# THẦN MỆNH: HẬU DUỆ VĂN LANG — CẤU HÌNH MÔI TRƯỜNG (ENV TEMPLATE)
# ==============================================================================
# Sao chép file này thành .env hoặc .env.local và điền các giá trị từ Supabase Dashboard:
# Project Settings -> API (URL, anon key, service_role key)

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT CONFIG (Vite Public - prefix VITE_)
# ------------------------------------------------------------------------------
# URL của Supabase project (ví dụ: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Khóa công khai Anon / Public Key (chịu sự kiểm soát nghiêm ngặt của Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Địa chỉ WebSocket Game Server (khi chạy local là ws://localhost:2567)
VITE_GAME_SERVER_URL=ws://localhost:2567

# ------------------------------------------------------------------------------
# 2. BACKEND GAME SERVER CONFIG (Chỉ dùng cho server Node.js / Colyseus)
# Tuyệt đối KHÔNG chia sẻ hoặc commit khóa service_role vào git!
# ------------------------------------------------------------------------------
# URL Supabase dùng cho server backend
SUPABASE_URL=https://your-project-id.supabase.co

# Khóa đặc quyền Service Role Key (bypasses RLS, dùng cho trusted server RPCs lưu dữ liệu)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Audience (mặc định của Supabase Auth là "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated

# (Tùy chọn) JWKS URL - nếu không điền, game server tự suy ra từ SUPABASE_URL
# SUPABASE_JWT_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
