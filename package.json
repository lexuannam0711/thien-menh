{
  "name": "than-menh-hau-due-van-lang",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:save": "node scripts/check-save.cjs",
    "check:auth": "node scripts/check-auth.cjs",
    "check:unit-coverage": "node scripts/check-unit-coverage.cjs",
    "check:unit-coverage-control": "node scripts/check-unit-coverage-control.cjs",
    "check:rpg": "node scripts/check-rpg.cjs",
    "check:content-audio": "node scripts/check-content-audio.cjs",
    "check:rpg-menu": "node scripts/check-rpg-menu.cjs",
    "check:browser": "node scripts/check-browser.cjs",
    "check:graphics": "node scripts/check-graphics.cjs",
    "check:sprites": "node scripts/check-sprites.cjs",
    "check:equipment": "node scripts/check-equipment.cjs",
    "check:equipment-browser": "node scripts/check-equipment-browser.cjs",
    "check:equipment-browser-control": "node scripts/check-equipment-browser.cjs --selfcheck",
    "check:graphics-stress": "node scripts/check-graphics-stress.cjs",
    "check:graphics-stress-control": "node scripts/check-graphics-stress-control.cjs",
    "check:npcs": "node scripts/check-npcs.cjs",
    "check:enemies": "node scripts/check-enemies.cjs",
    "check:environments": "node scripts/check-environments.cjs",
    "check:combat-vfx": "node scripts/check-combat-vfx.cjs",
    "check:icons": "node scripts/check-icons.cjs",
    "check:environment-atmosphere": "node scripts/check-environment-atmosphere.cjs",
    "check:rpg-visual": "node scripts/check-rpg-visual.cjs",
    "check:scene-presentation": "node scripts/check-scene-presentation.cjs",
    "check:player-status": "node scripts/check-player-status.cjs",
    "check:campaign": "node scripts/check-campaign.cjs",
    "check:campaign-control": "node scripts/check-campaign-control.cjs && node scripts/campaign-navigation.cjs && node scripts/campaign-dungeon.cjs && node scripts/campaign-rewards.cjs && node scripts/map-v8-coverage.cjs --selfcheck",
    "check:controls": "node scripts/check-controls-master.cjs",
    "check:all": "npm run build && npm run check:save && npm run check:rpg && npm run check:content-audio && npm run check:rpg-menu && npm run check:graphics && npm run check:sprites && npm run check:equipment && npm run check:npcs && npm run check:enemies && npm run check:environments && npm run check:combat-vfx && npm run check:icons && npm run check:environment-atmosphere && npm run check:rpg-visual && npm run check:scene-presentation && npm run check:player-status && npm run check:campaign-control && npm run check:graphics-stress-control && npm run check:equipment-browser-control && npm run check:controls && npm run check:minigames-db && npm run check:minigames && npm run check:minigames-client && npm run check:minigames-world",
    "server:typecheck": "tsc -p apps/game-server/tsconfig.json --noEmit",
    "server:start": "tsc -p apps/game-server/tsconfig.json && node --enable-source-maps dist/game-server/server.js",
    "check:game-server": "node scripts/check-game-server.cjs",
    "check:minigames-db": "node scripts/check-minigames-db.cjs",
    "check:minigames": "node scripts/check-minigames-engine.cjs",
    "check:minigames-client": "node scripts/check-minigames-client.cjs",
    "check:minigames-world": "node scripts/check-minigames-world.cjs"
  },
  "dependencies": {
    "@colyseus/colyseus": "npm:colyseus@^0.18.9",
    "@colyseus/schema": "^5.0.39",
    "@supabase/supabase-js": "^2.117.3",
    "colyseus.js": "npm:@colyseus/sdk@^0.18.5",
    "jose": "^6.2.12",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
